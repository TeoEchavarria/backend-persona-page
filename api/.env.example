# Postgres con pgvector. En local: docker compose up -d. En Vercel: la cadena
# "pooled" de Neon (Vercel Postgres), con ?sslmode=require.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio

# Secreto para PUT /admin/content (el frontend lo envía como SEARCH_ADMIN_TOKEN).
# Vacío = sincronización deshabilitada.
ADMIN_TOKEN=

# Orígenes del frontend, separados por comas.
CORS_ORIGINS=http://localhost:8080

# local = sentence-transformers (indexar, desarrollo). http = Hugging Face
# feature-extraction (Vercel: no puede cargar torch). Mismo modelo en ambos.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/{model}/pipeline/feature-extraction
# EMBEDDING_API_TOKEN=hf_...
