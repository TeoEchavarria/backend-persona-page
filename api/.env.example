# ─────────────────────────────────────────────────────────────────────────────
# Configuración de la API de búsqueda.
#
# En local: copia este archivo a api/.env y complétalo.
# En Vercel: este archivo NO se despliega (.env está en .gitignore y
# .vercelignore). Cada variable se carga en Vercel → proyecto de la API →
# Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────


# ── Base de datos ────────────────────────────────────────────────────────────

# Cadena de conexión a Postgres con la extensión pgvector.
#   Local: la base del docker-compose.yml (puerto 5433), como abajo.
#   Producción: en Vercel → Storage → tu base Neon → pestaña ".env.local", o
#   en console.neon.tech → Connect. Usa la cadena *pooled* (el host lleva
#   "-pooler") y conserva ?sslmode=require. No hace falta crear tablas: la
#   primera sincronización crea la extensión vector y el esquema.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio


# ── Seguridad ────────────────────────────────────────────────────────────────

# Contraseña que protege PUT /admin/content, el endpoint por el que el frontend
# envía las notas. No se saca de ningún lado: se genera, por ejemplo con
#   openssl rand -hex 32
# y se pone el MISMO valor en SEARCH_ADMIN_TOKEN del frontend.
# Vacío = el endpoint responde 403 y nadie puede cambiar el contenido.
ADMIN_TOKEN=

# Dominios desde los que un navegador puede llamar a la API, separados por
# comas, sin barra final. El protocolo cuenta (http ≠ https) y cada variante
# del dominio va aparte (con y sin www). Los puertos locales son los del
# servidor de Vite: 8080 (npm run dev) y 8099 (vista previa).
# En producción pon solo los dominios reales del sitio.
CORS_ORIGINS=http://localhost:8080,http://localhost:8099,https://www.echavarrias.com,https://echavarrias.com


# ── Embeddings ───────────────────────────────────────────────────────────────

# Dónde se calculan los vectores de las consultas y de los párrafos:
#   local → sentence-transformers en este mismo proceso. Requiere
#           `uv sync --extra local` y ~1 GB de RAM. Para desarrollo.
#   http  → la API de Hugging Face. Es la opción obligatoria en Vercel,
#           que no puede cargar torch.
# Los dos usan el mismo modelo, así que los vectores son compatibles.
EMBEDDING_BACKEND=local

# Modelo de Hugging Face y la cantidad de dimensiones de sus vectores.
# EMBEDDING_DIM tiene que coincidir con el modelo, porque define la columna
# vector(N) de la base. Si cambias de modelo, borra las tablas (o usa una
# base nueva) y sincroniza con `npm run search:sync -- --force`.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# Prefijos que la familia e5 espera delante del texto. Déjalos vacíos si usas
# un modelo que no los pide (p. ej. paraphrase-multilingual-*).
# QUERY_PREFIX="query: "
# PASSAGE_PREFIX="passage: "

# Solo con EMBEDDING_BACKEND=http.
# Token de Hugging Face: huggingface.co → Settings → Access Tokens → Create
# new token → tipo "Fine-grained" con el permiso "Make calls to Inference
# Providers". Empieza por hf_.
# EMBEDDING_API_TOKEN=hf_...

# URL del servicio de embeddings. {model} se reemplaza por EMBEDDING_MODEL.
# El valor por defecto es la API pública de Hugging Face, así que normalmente
# no hace falta tocarla. Cámbiala solo si creas un Inference Endpoint dedicado
# (más estable, de pago): usa la URL que te da Hugging Face.
# EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/{model}/pipeline/feature-extraction


# ── Ajustes finos (opcionales; los valores son los que ya usa la API) ────────

# Configuración de idioma de la búsqueda por palabras de Postgres (stemming).
# TEXT_SEARCH_CONFIG=spanish

# Cuántos párrafos devuelve una búsqueda y cuántos candidatos considera cada lista.
# RESULTS_LIMIT=5
# CANDIDATE_POOL=30
# RRF_K=60

# Bandas de confianza: margen = mejor similitud − similitud media.
# Recalíbralas con `uv run python -m scripts.calibrate` al cambiar el contenido.
# MARGIN_HIGH=0.075
# MARGIN_MEDIUM=0.046
# GAP_HIGH=0.045

# Rocchio: peso de la consulta frente al contexto (alpha) y memoria del
# contexto al leer (beta).
# ROCCHIO_ALPHA=0.7
# ROCCHIO_BETA=0.8

# Cadena de Markov entre notas y recomendaciones:
#   MARKOV_LAMBDA        fuerza del prior semántico frente a las visitas reales
#   MARKOV_TEMPERATURE   qué tan marcado es el prior (más bajo = más marcado)
#   FINISHED_WEIGHT      cuánto cuenta salir de una nota leída hasta el final
#   RESTART_PROBABILITY  random walk: probabilidad de volver a la nota de origen
#   MMR_LAMBDA           relevancia frente a diversidad en las relacionadas
# MARKOV_LAMBDA=2.0
# MARKOV_TEMPERATURE=0.015
# FINISHED_WEIGHT=2.0
# RESTART_PROBABILITY=0.3
# PAGERANK_DAMPING=0.85
# MMR_LAMBDA=0.7

# HMM de intención: INTENT_STICKINESS es la probabilidad de seguir en la misma
# intención entre una observación y la siguiente.
# INTENT_STICKINESS=0.8
# INTENT_TEMPERATURE=0.05

# Días sin actividad tras los que se borra una sesión y sus eventos.
# EVENT_RETENTION_DAYS=180
